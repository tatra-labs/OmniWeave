{"id": "s09", "page": 1, "kind": "paragraph", "layer": "body", "parent_kind": "list_item", "text": "Rest the dough for twenty minutes."}
{"id": "s10", "page": 1, "kind": "paragraph", "layer": "body", "parent_kind": "list_item", "text": "Cook each piece for two minutes a side."}
